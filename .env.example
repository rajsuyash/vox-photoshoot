# Copy to .env. Never commit .env — it is gitignored, and deploy.sh syncs these values
# into Secrets Manager, which is what the running container actually reads.
FAL_KEY=
HF_KEY=
ANTHROPIC_API_KEY=
# Postgres. sslmode=require is appended automatically if absent (db.py).
DATABASE_URL=postgresql://user:password@host:5432/donna
