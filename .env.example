# Copy to .env and fill in. Never commit .env — it is gitignored, and deploy.sh
# syncs these values into AWS Secrets Manager, which is what the running
# container actually reads. Nothing here is baked into the image.

# fal.ai — image generation. Every shoot and retouch spends this.
FAL_KEY=

# Anthropic — reads the uploaded piece (category, sub-type, description).
# Without it every upload is shot as the client's earrings. See product.identify.
ANTHROPIC_API_KEY=

# Higgsfield — the fallback provider. Optional; only used with PROVIDER=higgsfield.
HF_KEY=

# Postgres. sslmode=require is appended automatically if absent (db.py).
DATABASE_URL=postgresql://user:password@host:5432/donna

# --- Razorpay -----------------------------------------------------------------
# Dashboard > Account & Settings > API Keys. rzp_test_ to trial, rzp_live_ for real.
RAZORPAY_KEY_ID=
# Shown once at generation, never retrievable again.
RAZORPAY_KEY_SECRET=
# You invent this, then paste the same value into Razorpay's webhook settings.
# Endpoint: https://<your-host>/api/webhooks/razorpay
# Subscribe to invoice.paid ONLY — more than one event type double-credits.
RAZORPAY_WEBHOOK_SECRET=
